<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Your Bookings</h3>
            <hr>
            <% if(allBookings.length===0) { %>
                <p>You have no bookings yet. <a href="/listings">Explore listings</a></p>
                <% } else { %>
                    <div class="row">
                        <% for(let booking of allBookings) { %>
                            <div class="card col-5 ms-3 mb-3 listing-card">
                                <img src="<%= booking.listing.image.url %>" class="card-img-top" alt="listing_image"
                                    style="height: 10rem;">
                                <div class="card-body">
                                    <h5 class="card-title text-black">
                                        <%= booking.listing.title %>
                                    </h5>
                                    <p class="card-text text-black">
                                        <b>Check-in:</b>
                                        <%= booking.checkIn.toDateString() %> <br>
                                            <b>Check-out:</b>
                                            <%= booking.checkOut.toDateString() %> <br>
                                                <b>Total Price:</b> &#8377; <%=
                                                    booking.totalPrice.toLocaleString("en-IN") %>
                                    </p>
                                    <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-dark">View
                                        Listing</a>
                                </div>
                            </div>
                            <% } %>
                    </div>
                    <% } %>
        </div>
    </div>